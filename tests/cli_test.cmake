if(CASE STREQUAL "help")
    set(arguments --help)
    set(success TRUE)
elseif(CASE STREQUAL "load")
    set(arguments load "${SOURCE_DIR}/models/multiplier.json")
    set(success TRUE)
elseif(CASE STREQUAL "missing")
    set(arguments load "${SOURCE_DIR}/tests/nonexistent-model.json")
    set(success FALSE)
elseif(CASE STREQUAL "arguments")
    set(arguments load)
    set(success FALSE)
else()
    message(FATAL_ERROR "Unknown CLI case: ${CASE}")
endif()

execute_process(COMMAND "${PROGRAM}" ${arguments}
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT status MATCHES "^[0-9]+$")
    message(FATAL_ERROR "CLI terminated abnormally: ${status}\n${error}")
endif()
if(success)
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "CLI failed: ${status}\n${error}")
    endif()
    if(CASE STREQUAL "load" AND NOT output MATCHES "Validation MSE:")
        message(FATAL_ERROR "CLI did not run loaded model")
    endif()
    if(CASE STREQUAL "help" AND (NOT output MATCHES "load" OR NOT output MATCHES "train"))
        message(FATAL_ERROR "CLI help is missing subcommands")
    endif()
else()
    if(status EQUAL 0 OR error STREQUAL "")
        message(FATAL_ERROR "CLI must report failure: ${status}\n${output}")
    endif()
endif()
