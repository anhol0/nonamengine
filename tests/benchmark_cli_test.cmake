set(arguments --quick --warmup 0 --samples 2 --iterations 2)
set(success TRUE)
if(CASE STREQUAL "help")
    set(arguments --help)
elseif(CASE STREQUAL "matmul" OR CASE STREQUAL "training")
    list(APPEND arguments --filter "${CASE}")
elseif(CASE STREQUAL "missing_filter")
    list(APPEND arguments --filter no_such_operation)
    set(success FALSE)
elseif(CASE STREQUAL "zero_samples")
    set(arguments --samples 0)
    set(success FALSE)
elseif(CASE STREQUAL "zero_iterations")
    set(arguments --iterations 0)
    set(success FALSE)
elseif(CASE STREQUAL "negative_warmup")
    set(arguments --warmup -1)
    set(success FALSE)
elseif(NOT CASE STREQUAL "quick")
    message(FATAL_ERROR "Unknown benchmark CLI case")
endif()
execute_process(COMMAND "${PROGRAM}" ${arguments}
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 30)
if(NOT status MATCHES "^[0-9]+$")
    message(FATAL_ERROR "Benchmark terminated abnormally: ${status}\n${error}")
endif()
if(NOT success)
    if(status EQUAL 0 OR error STREQUAL "")
        message(FATAL_ERROR "Invalid arguments must report failure: ${status}\n${output}")
    endif()
elseif(NOT status EQUAL 0)
    message(FATAL_ERROR "Benchmark failed: ${status}\n${error}")
elseif(CASE STREQUAL "help")
    foreach(option --quick --warmup --samples --iterations --filter)
        if(NOT output MATCHES "${option}")
            message(FATAL_ERROR "Missing help for ${option}")
        endif()
    endforeach()
else()
    if(NOT error MATCHES "# build:" OR NOT error MATCHES "# compiler:")
        message(FATAL_ERROR "Reproducibility metadata must be written to stderr")
    endif()
    set(header "name,shape,warmup,samples,iterations,min_us,median_us,max_us,gflops,checksum")
    if(NOT output MATCHES "^${header}\n")
        message(FATAL_ERROR "Stdout must begin with the CSV header, without metadata")
    endif()
    string(REGEX REPLACE "^${header}\n" "" rows "${output}")
    string(REPLACE ";" "\\;" lines "${rows}")
    string(REPLACE "\n" ";" lines "${lines}")
    set(count 0)
    foreach(line IN LISTS lines)
        if(line STREQUAL "")
            continue()
        endif()
        # Timings are measurements, not machine-dependent pass/fail thresholds.
        if(NOT line MATCHES "^([^,]+),([^,]+),0,2,2,[0-9]+[.][0-9]+,[0-9]+[.][0-9]+,[0-9]+[.][0-9]+,([0-9]+[.][0-9]+)?,[-]?[0-9]+[.][0-9]+$")
            message(FATAL_ERROR "Malformed/non-finite result row: ${line}")
        endif()
        if(CASE STREQUAL "matmul" AND NOT line MATCHES "^matmul,")
            message(FATAL_ERROR "Matmul filter selected another operation")
        elseif(CASE STREQUAL "training" AND NOT line MATCHES "^training_step,")
            message(FATAL_ERROR "Training filter selected another operation")
        endif()
        math(EXPR count "${count} + 1")
    endforeach()
    if(count EQUAL 0)
        message(FATAL_ERROR "No workloads executed")
    endif()
    if(CASE STREQUAL "quick")
        foreach(operation add subtract multiply divide add_scalar subtract_scalar
                          multiply_scalar divide_scalar bias_column bias_row transpose relu matmul training_step)
            if(NOT output MATCHES "\n${operation},")
                message(FATAL_ERROR "Missing workload: ${operation}")
            endif()
        endforeach()
    endif()
endif()
